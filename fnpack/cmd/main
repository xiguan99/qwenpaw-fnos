#!/bin/bash
# qwenpaw 生命周期入口（照 freellmapi/deepseek.harness.fnos 版式）
# 双进程：qwenpaw 本体（venv python，绑内部端口）+ fnshell（direct 直通反代+桥接注入+网关 socket+API 层，监听对外端口；入口直达本体，面板为独立 app qwenpaw-panel）
LOG_FILE="${TRIM_PKGVAR}/info.log"
GW_LOG="${TRIM_PKGVAR}/gateway.log"
PID_FILE="${TRIM_PKGVAR}/app.pid"
GW_PID_FILE="${TRIM_PKGVAR}/gw.pid"
APP_DIR="${TRIM_APPDEST}"

LIB_TYPE="${wizard_data_library_type:-data}"
if [ "${LIB_TYPE}" = "data" ]; then
    DATA_LIBRARY_PATH="${TRIM_PKGVAR}"
else
    DATA_LIBRARY_PATH="${TRIM_DATA_SHARE_PATHS%%:*}"
fi
RUN_USER="${wizard_run_user:-root}"
DATA_DIR="${DATA_LIBRARY_PATH}/data"

VENV="${TRIM_PKGVAR}/venv"
WHEEL_DIR="${APP_DIR}/wheels"

# 套件 PATH（守护环境不含 python312，显式解析）
PY_RUNTIME="/var/apps/python312/target/bin/python3"
[ -x "${PY_RUNTIME}" ] || PY_RUNTIME="$(command -v python3 || true)"

export HOME="${DATA_DIR}"
export FNOS_CLI_PATH="${APP_DIR}/vendor/fnos-cli/scripts/fnos-cli"   # 官方技能授权（捆绑 fnos-cli，vendor 为源，部署进技能池）
export PATH="${DATA_DIR}/skill_pool/fnos-cli/scripts:${PATH}"        # 聊天内技能直接调用已部署的 fnos-cli
export QWENPAW_PORT="2277"          # 对外端口：壳（fnshell 直通反代）监听，桌面图标（经网关+桥接）与浏览器直连都走它
export QWENPAW_INTERNAL_PORT="22771"  # 本体内部端口，仅 127.0.0.1，由壳反代

log_msg() { echo "$(date '+%Y-%m-%d %H:%M:%S') [INFO] $1" >> "${LOG_FILE}"; }
log_err() { echo "$(date '+%Y-%m-%d %H:%M:%S') [ERROR] $1" >> "${LOG_FILE}"; }
check_process() { ps -p "$1" >/dev/null 2>&1; }

as_run_user() {
    # 以所选运行用户执行命令（root 时直接执行）
    if [ "${RUN_USER}" != "root" ] && id "${RUN_USER}" >/dev/null 2>&1; then
        su -s /bin/bash "${RUN_USER}" -c "$1"
    else
        bash -c "$1"
    fi
}

status() {
    if [ -f "${PID_FILE}" ]; then
        pid=$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')
        if check_process "${pid}"; then return 0; else rm -f "${PID_FILE}"; fi
    fi
    return 1
}

gw_status() {
    if [ -f "${GW_PID_FILE}" ]; then
        pid=$(head -n 1 "${GW_PID_FILE}" | tr -d '[:space:]')
        if check_process "${pid}"; then return 0; else rm -f "${GW_PID_FILE}"; fi
    fi
    return 1
}

ensure_venv() {
    # venv 持久在 PKGVAR（升级保留）；缺失时重建并从包内 wheel 安装（依赖联网拉取）
    [ -x "${VENV}/bin/python" ] && return 0
    log_msg "venv 缺失，重建并安装 wheel（依赖需联网，约几分钟）"
    [ -n "${PY_RUNTIME}" ] || { log_err "python312 套件未找到，无法建 venv"; return 1; }
    ls "${WHEEL_DIR}"/*.whl >/dev/null 2>&1 || { log_err "找不到 ${WHEEL_DIR}/*.whl"; return 1; }
    mkdir -p "${DATA_DIR}" 2>/dev/null || true
    as_run_user "mkdir -p '${DATA_DIR}' && '${PY_RUNTIME}' -m venv '${VENV}'" || { log_err "venv 创建失败"; return 1; }
    as_run_user "export HOME='${DATA_DIR}' && '${VENV}/bin/pip' install --no-input '${WHEEL_DIR}'/*.whl 'setuptools<82' >> '${LOG_FILE}' 2>&1" || { log_err "pip install 失败"; return 1; }
    log_msg "venv 就绪"
    return 0
}

ensure_fnos_skill() {
    # 官方 fnos 技能：vendor → 技能池（reconcile_pool_manifest 盘扫自动登记）+ 预置 CLI 缓存（首跑不联网）
    local src="${APP_DIR}/vendor/fnos-cli"
    [ -f "${src}/scripts/fnos-cli" ] || return 0
    local ver
    ver=$(sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "${src}/manifest.json" 2>/dev/null | head -1)
    [ -n "${ver}" ] || return 0
    local pool="${DATA_DIR}/skill_pool/fnos-cli"
    local stamp="${DATA_DIR}/.fnos-skill-version"
    local cache="${DATA_DIR}/.cache/fnos-cli/${ver}/linux-x64/fnos-cli"
    if [ -x "${pool}/scripts/fnos-cli" ] && [ -x "${cache}" ] && [ "$(cat "${stamp}" 2>/dev/null)" = "${ver}" ]; then
        return 0
    fi
    log_msg "部署官方 fnos 技能 (${ver})"
    mkdir -p "${DATA_DIR}/skill_pool" 2>/dev/null || return 0
    rm -rf "${pool}.tmp" "${pool}.old" 2>/dev/null
    if ! cp -a "${src}" "${pool}.tmp"; then log_err "fnos 技能复制失败"; return 0; fi
    [ -d "${pool}" ] && mv "${pool}" "${pool}.old"
    mv "${pool}.tmp" "${pool}"
    rm -rf "${pool}.old" 2>/dev/null
    chmod 755 "${pool}/scripts/fnos-cli" 2>/dev/null
    # 预置缓存：runtime-manifest.json 给出 linux-x64 资产的 gz 名/尺寸/sha256 与解压后校验值
    local meta gz_name gz_sha bin_size bin_sha
    # 输出单行 JSON（键恒在）：bash 的 read 对 tab 型 IFS 也会折叠连续空字段，禁用 tab 协议
    meta=$("${PY_RUNTIME}" - "${src}/runtime-manifest.json" <<'PYEOF' 2>/dev/null
import json, platform, sys
m = json.load(open(sys.argv[1]))
plat = "linux-x64" if platform.machine() in ("x86_64", "AMD64") else "linux-arm64"
a = (m.get("assets") or {}).get(plat)
if a:
    print(json.dumps({"name": str(a.get("name") or a.get("fileName") or ""),
                      "sha256": str(a.get("sha256") or a.get("gzSha256") or ""),
                      "binarySize": str(a.get("binarySize") or a.get("uncompressedSize") or ""),
                      "binarySha256": str(a.get("binarySha256") or a.get("sha256Uncompressed") or "")}))
PYEOF
)
    [ -n "${meta}" ] || { log_msg "fnos 缓存预置跳过（runtime-manifest 解析失败，技能首跑自动联网下载）"; printf "%s" "${ver}" > "${stamp}"; return 0; }
    jget() { printf '%s' "${meta}" | "${PY_RUNTIME}" -c 'import json,sys; print(json.load(sys.stdin).get(sys.argv[1],""))' "$1"; }
    gz_name=$(jget name); gz_sha=$(jget sha256); bin_size=$(jget binarySize); bin_sha=$(jget binarySha256)
    local gz="${src}/bin/${gz_name}"
    [ -f "${gz}" ] || gz=$(ls "${src}/bin/"*linux-x64.gz 2>/dev/null | head -1)
    if [ -n "${gz_sha}" ] && [ -f "${gz}" ]; then
        local actual
        actual=$(sha256sum "${gz}" | awk '{print $1}')
        [ "${actual}" = "${gz_sha}" ] || { log_err "fnos 二进制包校验失败，技能首跑自动联网下载"; gz=""; }
    fi
    if [ -n "${gz}" ] && [ -f "${gz}" ] && command -v gzip >/dev/null 2>&1; then
        mkdir -p "$(dirname "${cache}")" 2>/dev/null
        local tmp="${cache}.seeding"
        if gzip -dc "${gz}" > "${tmp}" 2>/dev/null; then
            local ok=1
            if [ -n "${bin_size}" ] && [ "$(stat -c %s "${tmp}")" != "${bin_size}" ]; then ok=0; fi
            if [ -n "${bin_sha}" ]; then
                local bsha; bsha=$(sha256sum "${tmp}" | awk '{print $1}')
                [ "${bsha}" = "${bin_sha}" ] || ok=0
            fi
            if [ "${ok}" = "1" ]; then
                mv "${tmp}" "${cache}"
                chmod 755 "${cache}"
                log_msg "fnos 命令行缓存就绪: ${cache}"
            else
                rm -f "${tmp}"
                log_err "fnos 二进制解压校验失败，技能首跑自动联网下载"
            fi
        else
            rm -f "${tmp}"
        fi
    fi
    [ "${RUN_USER}" != "root" ] && chown -R "${RUN_USER}" "${DATA_DIR}/skill_pool/fnos-cli" "${DATA_DIR}/.cache/fnos-cli" 2>/dev/null
    printf "%s" "${ver}" > "${stamp}"
    return 0
}

start_process() {
    status && return 0
    ensure_venv || return 1
    ensure_fnos_skill
    log_msg "启动 qwenpaw (INTERNAL_PORT=${QWENPAW_INTERNAL_PORT}, USER=${RUN_USER}, DATA=${DATA_DIR})"
    as_run_user "cd '${APP_DIR}' && exec '${VENV}/bin/python' -m qwenpaw app --host 127.0.0.1 --port ${QWENPAW_INTERNAL_PORT} >> '${LOG_FILE}' 2>&1 & echo \$!" &
    pid=$!
    sleep 3
    if ! check_process "${pid}"; then
        real=$(pgrep -f "qwenpaw app --host 127.0.0.1 --port ${QWENPAW_INTERNAL_PORT}" | head -1)
        [ -n "${real}" ] && pid="${real}"
    fi
    if check_process "${pid}"; then
        printf "%s" "${pid}" > "${PID_FILE}"
        log_msg "qwenpaw 启动成功 PID=${pid}"
    else
        log_err "qwenpaw 启动失败"
        return 1
    fi
    start_gateway
    return 0
}

start_backend_only() {
    status && { log_msg "qwenpaw 已在运行"; return 0; }
    gw_status || { log_err "壳未运行，先 start"; return 1; }
    ensure_venv || return 1
    ensure_fnos_skill
    log_msg "启动 qwenpaw 本体 (INTERNAL_PORT=${QWENPAW_INTERNAL_PORT})"
    as_run_user "cd '${APP_DIR}' && exec '${VENV}/bin/python' -m qwenpaw app --host 127.0.0.1 --port ${QWENPAW_INTERNAL_PORT} >> '${LOG_FILE}' 2>&1 & echo \$!" &
    pid=$!
    sleep 3
    if ! check_process "${pid}"; then
        real=$(pgrep -f "qwenpaw app --host 127.0.0.1 --port ${QWENPAW_INTERNAL_PORT}" | head -1)
        [ -n "${real}" ] && pid="${real}"
    fi
    check_process "${pid}" || { log_err "qwenpaw 启动失败"; return 1; }
    printf "%s" "${pid}" > "${PID_FILE}"
    log_msg "qwenpaw 启动成功 PID=${pid}"
}

start_gateway() {
    gw_status && return 0
    [ -x "${PY_RUNTIME}" ] || { log_err "fnshell 需要 python312 套件"; return 1; }
    [ -f "${APP_DIR}/fnshell.py" ] || { log_err "找不到 ${APP_DIR}/fnshell.py"; return 1; }
    log_msg "启动 fnshell (tcp ${QWENPAW_PORT}, backend 127.0.0.1:${QWENPAW_INTERNAL_PORT}, socket ${APP_DIR}/app.sock)"
    as_run_user "exec '${PY_RUNTIME}' '${APP_DIR}/fnshell.py' --backend 127.0.0.1:${QWENPAW_INTERNAL_PORT} --socket '${APP_DIR}/app.sock' --prefix /app/qwenpaw --tcp ${QWENPAW_PORT} --direct --cmd-dir '${APP_DIR}/cmd' --github-repo xiguan99/qwenpaw-fnos >> '${GW_LOG}' 2>&1 & echo \$!" &
    pid=$!
    sleep 2
    if ! check_process "${pid}"; then
        real=$(pgrep -f "fnshell.py --backend 127.0.0.1:${QWENPAW_INTERNAL_PORT} --socket" | head -1)
        [ -n "${real}" ] && pid="${real}"
    fi
    if check_process "${pid}"; then
        printf "%s" "${pid}" > "${GW_PID_FILE}"
        log_msg "fnshell 启动成功 PID=${pid}"
        return 0
    fi
    log_err "fnshell 启动失败（见 ${GW_LOG}）"
    return 1
}

stop_pidfile() {
    # $1=pidfile $2=pkill 模式串
    pf="$1"; pat="$2"
    if [ -f "${pf}" ]; then
        pid=$(head -n 1 "${pf}" | tr -d '[:space:]')
        if check_process "${pid}"; then
            kill -TERM "${pid}" 2>/dev/null
            count=0
            while check_process "${pid}" && [ $count -lt 5 ]; do sleep 1; count=$((count+1)); done
            check_process "${pid}" && { log_err "5 秒未退出，SIGKILL"; kill -KILL "${pid}" 2>/dev/null || true; }
        fi
        rm -f "${pf}"
    fi
    pkill -9 -f "${pat}" 2>/dev/null || true
}

stop_backend() {
    log_msg "停止 qwenpaw 本体"
    stop_pidfile "${PID_FILE}" "qwenpaw app --host 127.0.0.1 --port ${QWENPAW_INTERNAL_PORT}"
    log_msg "已停止"
}

stop_shell() {
    log_msg "停止 fnshell"
    stop_pidfile "${GW_PID_FILE}" "fnshell.py --backend 127.0.0.1:${QWENPAW_INTERNAL_PORT}"
    log_msg "已停止"
}

stop_process() {
    log_msg "停止 qwenpaw + fnshell"
    stop_pidfile "${PID_FILE}" "qwenpaw app --host 127.0.0.1 --port ${QWENPAW_INTERNAL_PORT}"
    stop_pidfile "${GW_PID_FILE}" "fnshell.py --backend 127.0.0.1:${QWENPAW_INTERNAL_PORT}"
    # 升级兼容：2.2.2.1 旧实例（app 直连 2278 + fngateway）兜底
    pkill -9 -f "qwenpaw app --host 127.0.0.1 --port 2278" 2>/dev/null || true
    pkill -9 -f "fngateway.py --listen 127.0.0.1:2278" 2>/dev/null || true
    # 升级兼容：2.2.2.2 单包实例（2278 壳 + 22781 本体）兜底——端口终态改 2277/22771，旧进程要杀掉
    pkill -9 -f "qwenpaw app --host 127.0.0.1 --port 22781" 2>/dev/null || true
    pkill -9 -f "fnshell.py --backend 127.0.0.1:22781" 2>/dev/null || true
    log_msg "已停止"
    return 0
}

case $1 in
start)            start_process ;;
stop)             stop_process ;;
status)           status && exit 0 || exit 3 ;;
start-backend)    start_backend_only ;;
stop-backend)     stop_backend ;;
restart-backend)  stop_backend; start_backend_only ;;
*)                exit 1 ;;
esac
